# Image tag pulled by docker compose / docker stack
LOBSTERS_IMAGE_TAG=latest

# Rails
RAILS_ENV=production
# Generate with:  bundle exec rails secret
SECRET_KEY_BASE=

# Database
DATABASE_NAME=lobsters_production
DATABASE_USER=lobsters
DATABASE_PASSWORD=
DATABASE_ROOT_PASSWORD=

# Optional: where to send Sentry errors in production
SENTRY_DSN=
